# Copy to .env and fill in real values. Never commit .env.

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults shown. "-latest" aliases track Google's current model
# so this doesn't silently break when a dated model gets deprecated.
# GEMINI_MODEL=gemini-flash-latest

# Optional. Set to true to log full message text/content in trace output
# (instead of just lengths/counts). Never enable this if traces might be shared.
# RORY_TRACE_VERBOSE=false
