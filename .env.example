# Copy to .env and fill in real values. Never commit .env.

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults shown. "-latest" aliases track Google's current model
# so this doesn't silently break when a dated model gets deprecated.
# GEMINI_MODEL=gemini-flash-latest

# Optional. Set to true to log full message text/content in trace output
# (instead of just lengths/counts). Never enable this if traces might be shared.
# RORY_TRACE_VERBOSE=false

# Voice. Optional unless TTS_ENGINE=sarvam or you're using speech input (STT
# always needs it). Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# "local" (default) uses espeak-ng and never touches your Sarvam credits —
# good for development. "sarvam" uses the real Bulbul voice, with automatic
# fallback to local if your Sarvam credit is exhausted (HTTP 402/403).
# TTS_ENGINE=local

# Any Bulbul v2 speaker name: anushka, manisha, vidya, abhilash, karun, hitesh.
# (arya is listed in Sarvam's docs but returned 500 on every attempt when
# this was tested — may not actually be live on v2). manisha and vidya are
# both worth a listen if the default doesn't suit you.
# TTS_VOICE=anushka

# espeak-ng voice id, used only when TTS_ENGINE=local. espeak-ng's base
# English voices are male; "+fN" (N = 1-4) is its female formant variant of
# the same voice. Try `espeak-ng --voices=en` for the full list of base voices.
# TTS_LOCAL_VOICE=en-us+f3
